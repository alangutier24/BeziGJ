--- !u!114 &614436003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 614436001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eecb4df5ede84f769ae82ce8edf222c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueInteraction
  dialogue:
    name: Elias
    sentences:
    - You're awake.
    - 'You''ve been asleep for two days now. '
    - You don't remember a thing, do you?
    - "Well we don't have time for that. \nShe's missinng. \nYou need to find her. "
    - 'But, before you go.  '
    - 'There''s something you might need.  '
    - 'Only for this time, I''ll grant you the power of vision.  '
    - 'It''ll allow you to find the key, and get out of here.  '
    - 'Look for Escanor, out there. '
    - 'He''ll help you get to where you need to go, and find out what happened.   '
  firstalertSfx: {fileID: 11400000, guid: b2c8275d6a7e545358f2abae19b0e7f9, type: 2}
  alertSfx: {fileID: 11400000, guid: b2c8275d6a7e545358f2abae19b0e7f9, type: 2}
  playSfx: 0
  hasInstruction: 1
  tutPower: {fileID: 614436006}
