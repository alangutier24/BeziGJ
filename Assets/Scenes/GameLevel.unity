  m_Script: {fileID: 11500000, guid: f2ed19af8b840445d96a813166081263, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  story:
  - name: Javier
    sentences:
    - Huh?
    - What's going on?
    - Where am I?
  - name: Javier
    sentences:
    - A necklace...
    - It's very nice.
    - It seems familiar.
    - Whose could it be?
  - name: Javier
    sentences:
    - These bills...
    - There's so many of them.
    - 'They are recent as well. '
    - Who could pay this off?
  - name: Javier
    sentences:
    - A calendar.
    - Some days are marked off.
    - Except this one. But it says something. Meet where we had our first date.
    - 'Meet who?

      Who is she?'
    - 'And where was this date? '
